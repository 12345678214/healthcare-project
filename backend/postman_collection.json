{
  "info": {
    "name": "Healthcare Appointment Management System API",
    "description": "Import into Postman. Set the collection variable base_url (default http://localhost:5000) and run 'Login' requests first to auto-populate token variables via the test script.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000"
    },
    {
      "key": "patient_token",
      "value": ""
    },
    {
      "key": "doctor_token",
      "value": ""
    },
    {
      "key": "admin_token",
      "value": ""
    },
    {
      "key": "doctor_id",
      "value": ""
    },
    {
      "key": "appointment_id",
      "value": ""
    },
    {
      "key": "leave_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newpatient@healthcare.demo\",\n  \"password\": \"Password@123\",\n  \"role\": \"PATIENT\",\n  \"fullName\": \"New Patient\"\n}"
            }
          }
        },
        {
          "name": "Login (Patient - seeded)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('patient_token', data.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patient1@healthcare.demo\",\n  \"password\": \"Password@123\"\n}"
            }
          }
        },
        {
          "name": "Login (Doctor - seeded)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('doctor_token', data.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"dr.sharma@healthcare.demo\",\n  \"password\": \"Password@123\"\n}"
            }
          }
        },
        {
          "name": "Login (Admin - seeded)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('admin_token', data.data.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@healthcare.demo\",\n  \"password\": \"Password@123\"\n}"
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patient_token}}"
              }
            ],
            "url": "{{base_url}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Doctors (Public)",
      "item": [
        {
          "name": "List Doctors",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/doctors"
          }
        },
        {
          "name": "Filter Doctors by Search",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/doctors?search=Sharma"
          }
        },
        {
          "name": "Get Doctor by Id",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/doctors/{{doctor_id}}"
          }
        },
        {
          "name": "Get Doctor Availability for a Date",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/doctors/{{doctor_id}}/availability?date=2026-09-01"
          }
        }
      ]
    },
    {
      "name": "Patient",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patient_token}}"
              }
            ],
            "url": "{{base_url}}/api/patients/profile"
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patient_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/patients/profile",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"9999999999\",\n  \"address\": \"123 Main St\"\n}"
            }
          }
        },
        {
          "name": "Book Appointment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.data && data.data.appointment) { pm.collectionVariables.set('appointment_id', data.data.appointment.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patient_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/appointments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"doctorId\": \"{{doctor_id}}\",\n  \"appointmentDate\": \"2026-09-01\",\n  \"startTime\": \"09:00\",\n  \"reasonForVisit\": \"General checkup\"\n}"
            }
          }
        },
        {
          "name": "My Appointments",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patient_token}}"
              }
            ],
            "url": "{{base_url}}/api/appointments"
          }
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patient_token}}"
              }
            ],
            "url": "{{base_url}}/api/appointments/{{appointment_id}}/cancel"
          }
        }
      ]
    },
    {
      "name": "Doctor",
      "item": [
        {
          "name": "Get My Doctor Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              }
            ],
            "url": "{{base_url}}/api/doctors/profile"
          }
        },
        {
          "name": "Add Availability",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/doctors/availability",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dayOfWeek\": 3,\n  \"startTime\": \"10:00\",\n  \"endTime\": \"12:00\",\n  \"slotDurationMinutes\": 30\n}"
            }
          }
        },
        {
          "name": "My Appointments (as Doctor)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              }
            ],
            "url": "{{base_url}}/api/appointments"
          }
        },
        {
          "name": "Confirm Appointment",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/appointments/{{appointment_id}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"CONFIRMED\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Dashboard Stats",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/api/admin/dashboard"
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/api/admin/users"
          }
        },
        {
          "name": "List All Doctors",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": "{{base_url}}/api/admin/doctors"
          }
        },
        {
          "name": "Approve Doctor",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/admin/doctors/{{doctor_id}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Doctor Leaves",
      "item": [
        {
          "name": "Add Leave",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.data && data.data.leave) { pm.collectionVariables.set('leave_id', data.data.leave.id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/doctors/leaves",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"2026-09-10\",\n  \"endDate\": \"2026-09-12\",\n  \"reason\": \"Personal leave\"\n}"
            }
          }
        },
        {
          "name": "Get My Leaves",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              }
            ],
            "url": "{{base_url}}/api/doctors/leaves"
          }
        },
        {
          "name": "Delete Leave",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              }
            ],
            "url": "{{base_url}}/api/doctors/leaves/{{leave_id}}"
          }
        }
      ]
    },
    {
      "name": "Medical Records",
      "item": [
        {
          "name": "Create/Update Medical Record (Doctor, appointment must be COMPLETED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{doctor_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/api/medical-records",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{appointment_id}}\",\n  \"diagnosis\": \"Viral fever\",\n  \"symptoms\": \"Fever, body ache\",\n  \"doctorNotes\": \"Rest and hydration advised.\",\n  \"followUpDate\": \"2026-09-05\",\n  \"medicines\": [\n    { \"medicineName\": \"Paracetamol\", \"dosage\": \"650mg\", \"instructions\": \"Twice daily after food\" }\n  ]\n}"
            }
          }
        },
        {
          "name": "List My Medical Records (role-aware)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patient_token}}"
              }
            ],
            "url": "{{base_url}}/api/medical-records"
          }
        }
      ]
    }
  ]
}